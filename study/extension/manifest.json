{
  "manifest_version": 3,
  "name": "뉴스 영어 노트",
  "version": "1.0.0",
  "description": "기사에서 선택한 영어 표현의 뜻을 보고 직접 쓴 요약과 첨삭을 저장합니다.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "scripting",
    "sidePanel",
    "storage",
    "nativeMessaging"
  ],
  "action": {
    "default_title": "이 기사로 영어 공부"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "background": {
    "service_worker": "worker.js"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+W"
      }
    }
  }
}
